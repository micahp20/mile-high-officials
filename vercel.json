{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/donate_1", "destination": "/donate", "permanent": true },
    { "source": "/donate_1/", "destination": "/donate", "permanent": true },
    { "source": "/contact-us_1", "destination": "/contact-us", "permanent": true },
    { "source": "/contact-us_1/", "destination": "/contact-us", "permanent": true },
    { "source": "/youth-sports-referee", "destination": "/youth-sports-officials", "permanent": true },
    { "source": "/youth-sports-referee/", "destination": "/youth-sports-officials", "permanent": true }
  ]
}
